# 客户端公开服务地址：H5 默认同源；小程序默认使用现有 Railway 域名
# 此变量可公开，不能在 VITE_ 前缀变量中存放密钥
VITE_TRAINING_API_BASE=

# 以下四项仅供服务端使用。开通腾讯云「口语评测（新版）」后在 Railway Variables 配置
# 没有真实凭据时保持 false；界面会提示服务待开通，不生成分数
SPEECH_ASSESSMENT_ENABLED=false
TENCENT_SOE_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 单个服务进程的每日调用上限；另有每来源每日20次、最多2个并发的体验限制
SPEECH_DAILY_LIMIT=100
# 如有单独前端域名，按逗号列出准确的来源；同源 H5 无需设置
SPEECH_ALLOWED_ORIGINS=
